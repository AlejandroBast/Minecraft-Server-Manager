# Copia este fichero como .env para sobrescribir la configuración por defecto.
# Todas las claves usan el prefijo MSM_.

MSM_DEBUG=false
MSM_HOST=127.0.0.1
MSM_PORT=8000
MSM_LOG_LEVEL=INFO

# Rutas (absolutas o relativas a la raíz del proyecto)
# MSM_SERVERS_DIR=D:/MinecraftServers
# MSM_BACKUPS_DIR=D:/MinecraftBackups
# MSM_JAVA_DIR=downloads/java

# Orígenes permitidos para el frontend
# MSM_CORS_ORIGINS=["http://localhost:3000"]
